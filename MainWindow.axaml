<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="MajdataEdit.MainWindow"
		Title="MajdataEdit" Height="589" Width="720" MinHeight="589" MinWidth="720"
		Loaded="OnWindowLoaded">
	<Grid Margin="0">
		<Grid.RowDefinitions>
			<RowDefinition Height="0*"/>
			<RowDefinition Height="501*"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>
		<Grid.Background>
			<LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%" >
				<GradientStop Color="#FF526675" Offset="0" />
				<GradientStop Color="#FF735573" Offset="1" />
			</LinearGradientBrush>
		</Grid.Background>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="358*"/>
			<ColumnDefinition Width="360*" />
		</Grid.ColumnDefinitions>

		<Menu Height="19" VerticalAlignment="Top" Background="{DynamicResource ButtonsBackground}"
              Foreground="{DynamicResource ButtonForeground}" Grid.ColumnSpan="3" Grid.RowSpan="2">
			<MenuItem x:Name="MenuFiles" Header="Files" Foreground="{DynamicResource ButtonForeground}">
				<MenuItem x:Name="Menu_New" Header="New" />
				<MenuItem x:Name="Menu_Open" Header="Open"  />
				<MenuItem x:Name="Menu_Save" Header="Save"  />
				<MenuItem x:Name="Menu_SaveAs" Header="SaveAs" IsEnabled="False"/>
				<Separator />
				<MenuItem x:Name="Menu_AutosaveRecover" Header="AutosaveRecoverWindowTitle"/>
				<Separator />
				<MenuItem x:Name="Menu_ExportRender" Header="ExportVideo"
                          IsEnabled="False" />

			</MenuItem>
			<MenuItem x:Name="MenuEdit" Header="Edit" IsEnabled="False"
                      Foreground="{DynamicResource ButtonForeground}">
				<MenuItem Header="MirrorLR"/>
				<MenuItem Header="MirrorUD"/>
				<MenuItem Header="Mirror180"/>
				<MenuItem Header="Mirror45"/>
				<MenuItem Header="MirrorCcw45"/>
				<Separator />
				<MenuItem Header="MapInfo"/>
				<Separator />
				<MenuItem Header="FindAndReplace"/>
			</MenuItem>
			<MenuItem x:Name="MenuSetting" Header="Setting" Foreground="{DynamicResource ButtonForeground}">
				<MenuItem x:Name="VolumnSetting" Header="Volume" IsEnabled="False" />
				<Separator />
				<MenuItem Header="EditorSetting"/>
				<MenuItem Header="RemapViewer"/>
			</MenuItem>
			<MenuItem x:Name="MenuTools" Header="Tools" Foreground="{DynamicResource ButtonForeground}">
				<MenuItem Header="BPMtap"/>
				<MenuItem x:Name="MenuMuriCheck" Header="MapMuriDetc"
                          IsEnabled="False" />
				<MenuItem x:Name="SyntaxCheckButton" Header="SyntaxDisplay"
                          IsEnabled="False" />
			</MenuItem>
			<MenuItem Header="Majnet" Foreground="{DynamicResource ButtonForeground}"
					  Click="OnMenuMajnetClick"/>
			<MenuItem Header="Github" Foreground="{DynamicResource ButtonForeground}"
					  Click="OnMenuGithubClick"/>
			<MenuItem x:Name="MenuCheckUpdate" Header="CheckUpdate" Foreground="{DynamicResource ButtonForeground}"
					  Click="OnMenuCheckUpdateClick"/>
		</Menu>
		<Label x:Name="TimeLabel" Content="0:00" Height="64" Width="105" Margin="8,16,0,0"
			   HorizontalAlignment="Left"
               VerticalAlignment="Top"  
			   Foreground="White" 
			   VerticalContentAlignment="Center" 
			   HorizontalContentAlignment="Center" 
			   FontFamily="Bahnschrift Light" 
			   FontSize="50"
			   Grid.Row="1" Grid.ColumnSpan="2" />
		<Label x:Name="NoteNowText" Content="行" Height="25" Width="105" Margin="8,73,0,0"
			   HorizontalAlignment="Left"  
			   VerticalAlignment="Top"
               Foreground="White"  
			   HorizontalContentAlignment="Center"
			   Grid.Row="1" Grid.ColumnSpan="2" />
		<ComboBox x:Name="LevelSelector" Height="32" Width="105" Margin="7,116,0,0" 
				  FontSize="10"
                  HorizontalAlignment="Left"   
				  VerticalAlignment="Top"
				  HorizontalContentAlignment="Left" 
				  VerticalContentAlignment="Center"
                  Background="{DynamicResource ButtonsBackground}" 
				  Foreground="{DynamicResource ButtonForeground}"
				  SelectionChanged="OnLevelSelctorChanged"
                  Grid.Row="1" Grid.Column="1">

			<ComboBoxItem Content="EASY" />
			<ComboBoxItem Content="BASIC" />
			<ComboBoxItem Content="ADVANCED" />
			<ComboBoxItem Content="EXPERT" />
			<ComboBoxItem Content="MASTER" />
			<ComboBoxItem Content="Re:MASTER" />
			<ComboBoxItem Content="ORIGINAL" />
		</ComboBox>

		<Label Content="Difficulty"  Height="32" Width="45" Margin="2,158,0,0"
               HorizontalAlignment="Left"
			   VerticalAlignment="Top"  
			   Foreground="White" 
			   Grid.Row="1" Grid.Column="1" />
		<TextBox x:Name="LevelTextBox"  Height="32" Width="46" Margin="47,154,0,0" 
                 HorizontalAlignment="Left"
				 VerticalAlignment="Top"  
				 HorizontalContentAlignment="Center" 
				 VerticalContentAlignment="Center"
                 Background="{DynamicResource ButtonsBackground}"
                 Foreground="{DynamicResource ButtonForeground}" 
				 TextWrapping="Wrap"
				 Grid.Row="1" Grid.Column="1" />

		<Label Content="Offset"  Height="32" Width="64" Margin="2,193,0,0"
               HorizontalAlignment="Left"
			   VerticalAlignment="Top"  
			   Foreground="White" 
			   Grid.Row="1" Grid.Column="1" />
		<TextBox x:Name="OffsetTextBox"  Height="32" Width="64" Margin="47,190,0,0" 
                 HorizontalAlignment="Left"
				 VerticalAlignment="Top"  
				 HorizontalContentAlignment="Center"
				 VerticalContentAlignment="Center"
				 TextWrapping="Wrap"
                 Background="{DynamicResource ButtonsBackground}" 
				 Foreground="{DynamicResource ButtonForeground}"
                 Grid.Row="1" Grid.Column="1" />


		<Button x:Name="Op_Button" Content="RecMode" Height="32" Width="105" Margin="6,0,0,165"
				HorizontalAlignment="Left"
                VerticalAlignment="Bottom" 
				VerticalContentAlignment="Center"
				HorizontalContentAlignment="Center"
				RenderTransformOrigin="1.1,0.25"
                Foreground="{DynamicResource ButtonForeground}" 
				Background="{DynamicResource ButtonsBackground}"
				Grid.Row="1" Grid.Column="1" />
		<!-- ToolTip="RecordModeDiscrp" -->
		<CheckBox x:Name="FollowPlayCheck" Content="TextFollow" Height="32" Width="105" Margin="6,0,0,130"
				  HorizontalAlignment="Left"
				  VerticalAlignment="Bottom"
				  VerticalContentAlignment="Center"
				  HorizontalContentAlignment="Center"
			      Foreground="{DynamicResource ButtonForeground}"
			      Background="{DynamicResource ButtonsBackground}"
                  Template="{DynamicResource DarkCheck}" 
				  Grid.Row="1" Grid.Column="1" />
		<Button x:Name="StopButton" Content="◼"  Height="38" Width="38" Margin="6,0,0,90"
				HorizontalAlignment="Left"
                VerticalAlignment="Bottom" 
				HorizontalContentAlignment="Center" 
				VerticalContentAlignment="Center"
                Background="{DynamicResource ButtonsBackground}" 
				Foreground="{DynamicResource ButtonForeground}"
				Grid.Row="1" Grid.Column="1" />
		<Button x:Name="PlayAndPauseButton" Content="▶" Height="38"  Width="38" Margin="73,0,0,90" 
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				HorizontalContentAlignment="Center" 
				VerticalContentAlignment="Center"
                Background="{DynamicResource ButtonsBackground}" 
				Foreground="{DynamicResource ButtonForeground}"
                Grid.Row="1" Grid.Column="1" />

		<Button x:Name="WaveViewZoomIn" Content="+" Height="28" Width="28" Margin="7,0,0,40"
				HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
				VerticalContentAlignment="Center" 
			    HorizontalContentAlignment="Center" 
                Background="{DynamicResource ButtonsBackground}" 
				Foreground="{DynamicResource ButtonForeground}"
                Template="{DynamicResource DarkButton}" 
				Grid.Row="1" Grid.Column="1" />
		<Button x:Name="WaveViewZoomOut" Content="-" Height="28" Width="28" Margin="7,0,0,9"
				HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
				VerticalContentAlignment="Center" 
			    HorizontalContentAlignment="Center" 
                Background="{DynamicResource ButtonsBackground}" 
				Foreground="{DynamicResource ButtonForeground}"
                Template="{DynamicResource DarkButton}" 
				Grid.Row="1" Grid.Column="1" />
		<Image x:Name="MusicWave" Height="74" 
			   VerticalAlignment="Bottom"
               Grid.ColumnSpan="3" Grid.RowSpan="2" Grid.Row="1" />

		<TextBox x:Name="FumenContent" Classes="Fumen" Padding="0,5" Margin="120,29,10,90"
                 FontFamily="Consolas"
				 Background="#4D171717"
                 Foreground="#FFE8E8E8"
				 ScrollViewer.HorizontalScrollBarVisibility="Auto"
				 ScrollViewer.VerticalScrollBarVisibility="Visible"
                 Grid.ColumnSpan="2" Grid.Row="1" Grid.Column="1">
		</TextBox>
	</Grid>
</Window>
